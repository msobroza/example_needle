# Copy to .env (git-ignored). Every variable has a default; see src/rag_load_test/settings.py.

# --- topology label (echoed in responses; locust records it) ---
RAG_TOPOLOGY=monolith

# --- embedder: local | ovms | fake ---
RAG_EMBEDDER_BACKEND=local
RAG_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
RAG_OVMS_EMBEDDINGS_URL=http://localhost:8002
RAG_OVMS_EMBEDDINGS_MODEL=bge-small-en-v1.5

# --- reranker: local | ovms | fake | none ---
RAG_RERANKER_BACKEND=local
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_OVMS_RERANK_URL=http://localhost:8001
RAG_OVMS_RERANK_MODEL=bge-reranker-base

# --- auth for OVMS calls: none | static | domino ---
RAG_OVMS_AUTH=none
RAG_OVMS_BEARER_TOKEN=
RAG_DOMINO_ACCESS_TOKEN_URL=http://localhost:8899/access-token
RAG_HTTP_TIMEOUT_S=30
RAG_HTTP_MAX_RETRIES=2

# --- LLM: openai | fake ---
RAG_LLM_BACKEND=openai
RAG_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://<domino-ai-gateway>/v1
RAG_OPENAI_TIMEOUT_S=60
RAG_OPENAI_MAX_RETRIES=2
RAG_FAKE_LLM_LATENCY_MS=0

# --- vector store ---
RAG_CHROMA_PATH=./data/chroma
RAG_CHROMA_COLLECTION=rag_passages
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_MODEL_THREADS=4

# --- service ---
RAG_DOMINO_TRACING=false
RAG_HOST=0.0.0.0
RAG_PORT=8888
RAG_LOG_LEVEL=info

# --- locust (client side) ---
# RAG_LOADTEST_BEARER_TOKEN=          # Authorization: Bearer ... (Domino access token)
# DOMINO_API_KEY=                     # X-Domino-Api-Key: ... (from a laptop)
# RAG_LOADTEST_QUERY_WEIGHT=1
# RAG_LOADTEST_RETRIEVE_WEIGHT=3
# RAG_LOADTEST_SHAPE=step

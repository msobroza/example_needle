# Domino compute environment for the RAG apps (app_monolith.sh / app_workflow.sh).
#
# Build from the REPOSITORY ROOT so `rag_load_test/` is in the context:
#   docker build -f rag_load_test/domino/environment/Dockerfile.rag -t rag-load-test-env .
# In Domino, either reference the pushed image as a custom base image, or pick the
# BASE_IMAGE below as the base environment and paste everything after FROM into the
# environment's "Dockerfile Instructions" field.
ARG BASE_IMAGE=quay.io/domino/compute-environment-images:ubuntu22-py3.10-r4.4-domino6.2-standard
FROM ${BASE_IMAGE}

USER root

COPY rag_load_test /opt/rag_load_test
# [loadtest] adds locust (drive the load test from a Workspace); [domino] adds
# dominodatalab[agents] for RAG_DOMINO_TRACING=true.
RUN pip install --no-cache-dir "/opt/rag_load_test[loadtest,domino]"

# Pre-download the two HF models at build time so app start-up needs no network.
# Shared HF_HOME (world-readable) because the build runs as root but Domino
# executes apps as the ubuntu user.
ENV HF_HOME=/opt/hf-cache
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer('BAAI/bge-small-en-v1.5'); CrossEncoder('BAAI/bge-reranker-base')" \
    && chmod -R a+rX /opt/hf-cache
ENV HF_HUB_OFFLINE=1

USER ubuntu
